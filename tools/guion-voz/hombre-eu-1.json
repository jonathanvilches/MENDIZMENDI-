[{"id": "inicio-1", "texto": "Arratsalde on eta ongi etorri frontoira. Hasi da partida."}, {"id": "inicio-2", "texto": "Dena prest frontoian. Hasi dadila partida!"}, {"id": "inicio-3", "texto": "Arratsalde on. Harmailak beteta daude, eta pilotariak prest."}, {"id": "dejada-1", "texto": "Hau utzia! Pilota hilda frontisaren ondoan."}, {"id": "dejada-2", "texto": "Utzi eta hilda. Ezer egiteko ez."}, {"id": "cortada-1", "texto": "Cortada txaparen ondotik."}, {"id": "cortada-2", "texto": "Zer cortada! Ez du ikusi ere egin."}, {"id": "dosparedes-1", "texto": "Bi paretara! Pilotak kantxa gurutzatu du."}, {"id": "dosparedes-2", "texto": "Bi pareta ederra."}, {"id": "volea-1", "texto": "Boleaz! Botatzen utzi gabe."}, {"id": "volea-2", "texto": "Aurreratu eta airez errematatu du."}, {"id": "gancho-1", "texto": "Ezkerrerako ganchoa, eta tantoa."}, {"id": "saque-1", "texto": "Sake zuzena!"}, {"id": "saque-2", "texto": "Ez da sakera iritsi."}, {"id": "golpe-1", "texto": "Tanto ederra."}, {"id": "golpe-2", "texto": "Ez da iritsi. Tantoa."}, {"id": "golpe-3", "texto": "Zer tantoa!"}, {"id": "chapa-1", "texto": "Txapara. Tantoa opari."}, {"id": "chapa-2", "texto": "Txapara bidali du."}, {"id": "fuera-1", "texto": "Kanpora."}, {"id": "fuera-2", "texto": "Kanpora. Gehiegi jo du."}, {"id": "falta-1", "texto": "Sake falta: ez da laugarren marrara iritsi."}, {"id": "pasa-1", "texto": "Pasa: sakea luzeegi joan da."}, {"id": "fallo-1", "texto": "Hutsa. Tantoa markagailura."}, {"id": "fallo-2", "texto": "Huts egin du. Tantoa opari."}, {"id": "iguala-1", "texto": "Berdinduta! Dena hasieratik."}]