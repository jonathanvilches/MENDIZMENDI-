[{"id": "inicio-1", "texto": "Buenas tardes y bienvenidos al frontón. Empieza el partido."}, {"id": "inicio-2", "texto": "Todo listo en el frontón. ¡Que empiece el partido!"}, {"id": "inicio-3", "texto": "Buenas tardes. La grada está llena y los pelotaris, preparados."}, {"id": "dejada-1", "texto": "¡Qué dejada! Muerta junto al frontis."}, {"id": "dejada-2", "texto": "La deja muerta. Nada que hacer."}, {"id": "cortada-1", "texto": "Cortada rasa, pegada a la chapa."}, {"id": "cortada-2", "texto": "¡Qué cortada! Ni la ha visto."}, {"id": "dosparedes-1", "texto": "¡A dos paredes! La pelota cruza la cancha."}, {"id": "dosparedes-2", "texto": "Dos paredes de manual."}, {"id": "volea-1", "texto": "¡De volea! Sin dejarla botar."}, {"id": "volea-2", "texto": "Se adelanta y remata de aire."}, {"id": "gancho-1", "texto": "Gancho a la izquierda, y tanto."}, {"id": "saque-1", "texto": "¡Saque directo!"}, {"id": "saque-2", "texto": "No llega al saque."}, {"id": "golpe-1", "texto": "Buen tanto."}, {"id": "golpe-2", "texto": "No llega. Tanto."}, {"id": "golpe-3", "texto": "¡Qué tanto!"}, {"id": "chapa-1", "texto": "A la chapa. Tanto regalado."}, {"id": "chapa-2", "texto": "La manda a la chapa."}, {"id": "fuera-1", "texto": "Se va fuera."}, {"id": "fuera-2", "texto": "Fuera. Ha pegado demasiado."}, {"id": "falta-1", "texto": "Falta de saque: no ha pasado del cuatro."}, {"id": "pasa-1", "texto": "Pasa: el saque se ha ido largo."}, {"id": "fallo-1", "texto": "Fallo. Sube el tanto al marcador."}, {"id": "fallo-2", "texto": "Se equivoca. Tanto regalado."}]