[{"id": "iguala-2", "texto": "Berdinketa markagailuan! Partida berria."}, {"id": "remonta-1", "texto": "Buelta eman dio! Aurrean jarri da."}, {"id": "tantoPartido-1", "texto": "Partidako tantoa."}, {"id": "tantoPartido-2", "texto": "Bat gehiago eta amaitu da: partidako tantoa."}, {"id": "finalYo-1", "texto": "Amaitu da! Garaipena zuretzat."}, {"id": "finalYo-2", "texto": "Partida irabazita! Zorionak."}, {"id": "finalRival-1", "texto": "Amaitu da. Oraingoan aurkariak irabazi du."}, {"id": "finalRival-2", "texto": "Partidaren amaiera. Garaipena aurkariarentzat."}, {"id": "granfinal-1", "texto": "Finala handia! Gaur txapela jokatzen da."}, {"id": "sorteo-1", "texto": "Goazen zozketara: nork aterako du lehenik?"}, {"id": "txapela-1", "texto": "Txapeldun! Txapela zurea da!"}, {"id": "reto-1", "texto": "Hiru izar! Primeran!"}]