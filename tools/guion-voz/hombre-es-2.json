[{"id": "iguala-1", "texto": "¡Igualados! Esto vuelve a empezar."}, {"id": "iguala-2", "texto": "¡Empate en el marcador! Partido nuevo."}, {"id": "remonta-1", "texto": "¡Remontada! Se pone por delante."}, {"id": "tantoPartido-1", "texto": "Tanto de partido."}, {"id": "tantoPartido-2", "texto": "Uno más y se acaba: tanto de partido."}, {"id": "finalYo-1", "texto": "¡Se acabó! Victoria para ti."}, {"id": "finalYo-2", "texto": "¡Partido ganado! Enhorabuena."}, {"id": "finalRival-1", "texto": "Se acabó. Esta vez gana el rival."}, {"id": "finalRival-2", "texto": "Final del partido. El rival se lleva la victoria."}, {"id": "granfinal-1", "texto": "¡Gran final! Hoy se juega la txapela."}, {"id": "sorteo-1", "texto": "Vamos con el sorteo: ¿quién saca primero?"}, {"id": "txapela-1", "texto": "¡Txapeldun! ¡La txapela es tuya!"}, {"id": "reto-1", "texto": "¡Tres estrellas! ¡Perfecto!"}]